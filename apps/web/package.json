{
  "name": "polaris-wms-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:crud": "node scripts/check-crud-page-standards.mjs && node scripts/check-semantic-tag-standards.mjs && node scripts/check-theme-accent-standards.mjs",
    "check:crud:test": "node scripts/check-crud-page-standards.mjs --self-test",
    "check:semantic-tags": "node scripts/check-semantic-tag-standards.mjs",
    "check:semantic-tags:test": "node scripts/check-semantic-tag-standards.mjs --self-test",
    "check:theme-accent": "node scripts/check-theme-accent-standards.mjs",
    "build": "npm run check:crud && vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "axios": "^1.13.4",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "sass": "^1.97.3",
    "vue": "^3.5.24",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
